{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "static/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/static/downloads/.*\\.exe",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ]
}
